<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Mac App's Avalonia layer (ADR 0006), the counterpart of Skua.WPF: the Game View, and later Core's views and platform services. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.MacOS\Skua.MacOS.csproj" />
  </ItemGroup>

</Project>
