<!-- Ported from Skua.WPF/UserControls/CoreBotsOptions/CBOptionsUserControl.xaml; the rows are CoreBotsOptionRows'. -->
<UserControl
    x:Class="Skua.Avalonia.Views.CBOptionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:Skua.Core.ViewModels"
    x:DataType="vms:CBOptionsViewModel">
    <DockPanel>
        <TextBox x:Name="SearchBox" Margin="6" DockPanel.Dock="Top" PlaceholderText="Search" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Options" Margin="6,0,6,6" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
