<!-- Ported from Skua.WPF/UserControls/LogTabUserControl.xaml. -->
<UserControl
    x:Class="Skua.Avalonia.Views.LogTabView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:Skua.Core.ViewModels"
    x:DataType="vms:LogTabViewModel">
    <Grid RowDefinitions="*,Auto">
        <ListBox
            x:Name="Lines"
            Grid.Row="0"
            ItemsSource="{Binding Logs}"
            SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*">
            <Button Grid.Column="0" Margin="0,6,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ClearLogCommand}" Content="Clear" />
            <Button Grid.Column="1" Margin="3,6,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CopyLogCommand}" Content="Copy" />
            <Button Grid.Column="2" Margin="3,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveLogCommand}" Content="Save" />
        </Grid>
    </Grid>
</UserControl>
