<!-- Ported from Skua.WPF/Views/ScriptLoaderView.xaml. -->
<UserControl
    x:Class="Skua.Avalonia.Views.ScriptLoaderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:Skua.Core.ViewModels"
    x:DataType="vms:ScriptLoaderViewModel">
    <Grid Margin="6" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock
                x:Name="Status"
                Margin="0,0,0,3"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding ScriptStatus, StringFormat='Status: {0}'}"
                ToolTip.Tip="{Binding ScriptErrorToolTip}" />
            <TextBlock
                x:Name="LoadedScript"
                Margin="0,3"
                HorizontalAlignment="Center"
                FontSize="20"
                Text="{Binding LoadedScript}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" HorizontalAlignment="Stretch" Command="{Binding LoadScriptCommand}" Content="Load Script" />
            <Button Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" HorizontalAlignment="Stretch" Command="{Binding OpenVSCodeCommand}" Content="Open VSCode" />
            <Button Grid.Row="1" Grid.Column="0" Margin="0,3,3,3" HorizontalAlignment="Stretch" Command="{Binding EditScriptCommand}" Content="Edit Script" />
            <Button
                x:Name="SearchScripts"
                Grid.Row="1"
                Grid.Column="1"
                Margin="3,3,0,3"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenScriptRepoCommand}"
                Content="Search Scripts" />
            <Button
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,3"
                HorizontalAlignment="Stretch"
                Command="{Binding EditScriptConfigCommand}"
                Content="Edit Script Options"
                IsEnabled="{Binding ToggleScriptEnabled}" />
            <Button
                x:Name="ToggleScript"
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,3,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Classes="accent"
                Command="{Binding ToggleScriptCommand}"
                IsEnabled="{Binding ToggleScriptEnabled}">
                <Panel>
                    <TextBlock IsVisible="{Binding !ScriptManager.ScriptRunning}" Text="Start Script" />
                    <TextBlock IsVisible="{Binding ScriptManager.ScriptRunning}" Text="Stop Script" />
                </Panel>
            </Button>
        </Grid>
        <ContentControl Grid.Row="2" Margin="0,3" Content="{Binding ScriptLogs}" />
        <Button
            Grid.Row="3"
            Margin="0,3,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding OpenBrowserFormCommand}"
            Content="Report Issues to @Tato2/@bogalj" />
    </Grid>
</UserControl>
