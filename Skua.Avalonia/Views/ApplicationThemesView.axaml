<!-- Ported from Skua.WPF/Views/ApplicationThemesView.xaml and its ThemeItemUserControl. -->
<UserControl
    x:Class="Skua.Avalonia.Views.ApplicationThemesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Skua.Avalonia.Services"
    xmlns:views="using:Skua.Avalonia.Views"
    xmlns:vms="using:Skua.Core.ViewModels"
    x:DataType="vms:ApplicationThemesViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <views:ColorSchemeEditorView DataContext="{Binding ColorSchemeEditor}" />
            <Expander
                Margin="6,3,6,6"
                HorizontalAlignment="Stretch"
                Header="Defined Themes">
                <StackPanel>
                    <ItemsControl x:Name="Presets" ItemsSource="{Binding ThemeService.Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:SkuaTheme">
                                <Button
                                    Margin="3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{Binding PrimaryBrush}"
                                    Content="{Binding Name}"
                                    Foreground="{Binding PrimaryForegroundBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="UserThemes" ItemsSource="{Binding ThemeService.UserThemes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:SkuaTheme">
                                <Grid Margin="3" ColumnDefinitions="*,Auto">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Background="{Binding PrimaryBrush}"
                                        Content="{Binding Name}"
                                        Foreground="{Binding PrimaryForegroundBrush}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="1,0,0,0"
                                        Background="{Binding PrimaryBrush}"
                                        Content="−"
                                        Foreground="{Binding PrimaryForegroundBrush}"
                                        Tag="remove"
                                        ToolTip.Tip="Remove this theme" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <Expander
                Margin="6,3,6,6"
                HorizontalAlignment="Stretch"
                Header="Backgrounds">
                <Grid
                    x:DataType="vms:BackgroundThemeViewModel"
                    ColumnDefinitions="*,Auto,Auto"
                    DataContext="{Binding BackgroundTheme}"
                    RowDefinitions="Auto,Auto">
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="3"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AvailableBackgrounds}"
                        PlaceholderText="Select Background"
                        SelectedItem="{Binding SelectedBackground}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="3"
                        Command="{Binding BrowseBackgroundCommand}"
                        Content="Browse"
                        ToolTip.Tip="Browse for a local SWF file" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="3"
                        Command="{Binding RefreshBackgroundsCommand}"
                        Content="Refresh"
                        ToolTip.Tip="Refresh the background list" />
                    <Button
                        x:Name="OpenThemesFolder"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding OpenThemesFolderCommand}"
                        Content="Open Themes Folder"
                        ToolTip.Tip="Open the themes folder in Finder" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding GetBackgroundsCommand}"
                        Content="Get Backgrounds"
                        ToolTip.Tip="Open the GitHub repository with more backgrounds" />
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
