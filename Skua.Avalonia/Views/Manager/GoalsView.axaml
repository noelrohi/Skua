<!-- Ported from Skua.WPF/UserControls/GoalsUserControl.xaml. -->
<UserControl
    x:Class="Skua.Avalonia.Views.Manager.GoalsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mvms="using:Skua.Core.ViewModels.Manager"
    xmlns:gh="using:Skua.Core.Models.GitHub"
    x:DataType="mvms:GoalsViewModel">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <Button Content="PayPal" Command="{Binding OpenPaypalLink}" />
            <Button Content="Ko-fi" Command="{Binding OpenKofiLink}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="GoalStatus" Text="{Binding Status}" />
        <ScrollViewer>
            <ItemsControl x:Name="GoalList" ItemsSource="{Binding Goals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="gh:GoalObject">
                        <StackPanel Margin="0,0,0,12" Spacing="4">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding Description}" />
                            <ProgressBar Minimum="0" Maximum="{Binding GoalValue}" Value="{Binding CurrentValue}" ShowProgressText="True" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
