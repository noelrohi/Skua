<!-- Ported from Skua.WPF/UserControls/HotKeyItemUserControl.xaml. -->
<UserControl
    x:Class="Skua.Avalonia.Views.HotKeyItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Skua.Avalonia.Views"
    xmlns:vms="using:Skua.Core.ViewModels"
    x:DataType="vms:HotKeyItemViewModel">
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Title" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Column="0"
            Margin="3,0,6,0"
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="Bold"
            Text="{Binding Title, StringFormat={}{0}:}"
            TextAlignment="Right" />
        <Button
            x:Name="Gesture"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding EditHotKeyCommand}"
            Content="{Binding KeyGesture, Converter={x:Static local:HotKeyItemView.Shown}}" />
    </Grid>
</UserControl>
