<Project Sdk="Microsoft.NET.Sdk">

  <!-- Control Surface tests: they start a real skua-engine and drive it through Skua.Control, the skua CLI and skua mcp. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <!-- The executables under test land next to the tests: skua-engine, skua and fake-gamehost. -->
    <ProjectReference Include="..\Skua.App.Cli\Skua.App.Cli.csproj" />
    <ProjectReference Include="..\Skua.App.Engine\Skua.App.Engine.csproj" />
    <ProjectReference Include="..\Skua.FakeGameHost\Skua.FakeGameHost.csproj" />
  </ItemGroup>

</Project>
