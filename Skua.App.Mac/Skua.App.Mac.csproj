<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Mac App (ADR 0006), the counterpart of Skua.App.WPF: the Game View, with its own Engine inside it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Skua</AssemblyName>
    <RootNamespace>Skua.App.Mac</RootNamespace>
  </PropertyGroup>

  <!-- The Skua Manager's Updates tab compares the installed build with the checkout this app was built from. -->
  <ItemGroup>
    <AssemblyMetadata Include="SkuaCheckout" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Avalonia\Skua.Avalonia.csproj" />
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <ProjectReference Include="..\Skua.Engine\Skua.Engine.csproj" />
    <!-- Only orders the build: skua-engine's build runs cargo and mxmlc first, so the shared MacBuild.targets below find both up to date. -->
    <ProjectReference Include="..\Skua.App.Engine\Skua.App.Engine.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Import Project="..\Skua.App.Engine\MacBuild.targets" />
  <Import Project="AppBundle.targets" />

</Project>
