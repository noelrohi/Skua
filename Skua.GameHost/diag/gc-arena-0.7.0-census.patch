+/// skua #13 census: a tracer that records every strong pointer a value holds.
+pub struct SkuaFinder {
+    pub(crate) out: Vec<usize>,
+}
+
+impl<'gc> Trace<'gc> for SkuaFinder {
+    fn trace_gc(&mut self, gc: Gc<'gc, ()>) {
+        self.out.push(gc.ptr.as_ptr() as usize);
+    }
+
+    fn trace_gc_weak(&mut self, _gc: GcWeak<'gc, ()>) {}
+}
+
+impl Context {
+    /// skua #13 census: visit every live allocation with its type and the strong pointers it holds.
+    pub(crate) fn skua_edges(&self, f: &mut dyn FnMut(&'static str, *const (), &[usize])) {
+        let mut rec = SkuaFinder { out: Vec::new() };
+        let mut cur = self.all.get();
+        while let Some(p) = cur {
+            let h = p.header();
+            if h.is_live() {
+                rec.out.clear();
+                unsafe { (h.vtable().find_value)(p.as_ptr() as *const (), &mut rec) };
+                f((h.vtable().type_name)(), p.as_ptr() as *const (), &rec.out);
+            }
+            cur = h.next();
+        }
+    }
+
+    /// skua #13 census: (type name, live objects, bytes) for every allocation on the `all` list.
+    pub(crate) fn skua_census(&self) -> alloc::vec::Vec<(&'static str, usize, usize)> {
+        let mut map: alloc::collections::BTreeMap<&'static str, (usize, usize)> = Default::default();
+        let mut cur = self.all.get();
+        while let Some(p) = cur {
+            let h = p.header();
+            let vt = h.vtable();
+            let e = map.entry((vt.type_name)()).or_insert((0, 0));
+            e.0 += 1;
+            e.1 += vt.value_layout.size();
+            cur = h.next();
+        }
+        map.into_iter().map(|(k, (n, b))| (k, n, b)).collect()
+    }
+
+    /// skua #13 census: visit every allocation whose value is still live, with its type name.
+    pub(crate) fn skua_visit(&self, f: &mut dyn FnMut(&'static str, *const ())) {
+        let mut cur = self.all.get();
+        while let Some(p) = cur {
+            let h = p.header();
+            if h.is_live() {
+                f((h.vtable().type_name)(), p.as_ptr() as *const ());
+            }
+            cur = h.next();
+        }
+    }
+}
+
 impl Drop for Context {
     fn drop(&mut self) {
         struct DropAll<'a>(&'a Metrics, Option<GcPtr>);
