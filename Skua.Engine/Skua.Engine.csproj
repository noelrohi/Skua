<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Engine as a library (ADR 0006): skua-engine hosts it headless, and the Mac App hosts it in its own process. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <ProjectReference Include="..\Skua.Core\Skua.Core.csproj" />
    <ProjectReference Include="..\Skua.MacOS\Skua.MacOS.csproj" />
  </ItemGroup>

</Project>
