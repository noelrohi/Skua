<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>skua</AssemblyName>
    <RootNamespace>Skua.App.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The agent skill, which the skill option prints. -->
    <EmbeddedResource Include="..\skills\skua\SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <!-- The commands that need no Engine run the Engine's own code in this process: the scripts commands and scripts check. -->
    <ProjectReference Include="..\Skua.Engine\Skua.Engine.csproj" />
  </ItemGroup>

</Project>
