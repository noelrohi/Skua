<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>skua-engine</AssemblyName>
    <RootNamespace>Skua.App.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <ProjectReference Include="..\Skua.Core\Skua.Core.csproj" />
    <ProjectReference Include="..\Skua.MacOS\Skua.MacOS.csproj" />
    <!-- Only for the flat output layout: skua lands next to skua-engine. -->
    <ProjectReference Include="..\Skua.App.Cli\Skua.App.Cli.csproj" />
  </ItemGroup>

  <Import Project="MacBuild.targets" />

</Project>
