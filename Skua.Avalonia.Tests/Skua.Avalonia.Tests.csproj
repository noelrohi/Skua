<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia.Headless tests of the Mac App's Avalonia layer, over an Engine hosted in this process as the app hosts it, with the fake Game Host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Butlerv4Tests changes the Scripts' plugin to listen on the loopback address only. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The Engine tests' fake servers API and fake security tool, and for the take-over tests their sandbox and stand-in Engine. -->
  <ItemGroup>
    <Compile Include="..\Skua.Engine.Tests\FakeAqApi.cs" Link="Fakes\FakeAqApi.cs" />
    <Compile Include="..\Skua.Engine.Tests\LoopbackHttp.cs" Link="Fakes\LoopbackHttp.cs" />
    <Compile Include="..\Skua.Engine.Tests\FakeKeychain.cs" Link="Fakes\FakeKeychain.cs" />
    <Compile Include="..\Skua.Engine.Tests\EngineSandbox.cs" Link="Fakes\EngineSandbox.cs" />
    <Compile Include="..\Skua.Engine.Tests\OtherVersionEngine.cs" Link="Fakes\OtherVersionEngine.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Engine tests' stand-in for GitHub, serving the Script Source. -->
    <Compile Include="..\Skua.Engine.Tests\FakeGitHub.cs" Link="FakeGitHub.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Engine tests' waits on the Engine's logs. -->
    <Compile Include="..\Skua.Engine.Tests\LogWaits.cs" Link="Fakes\LogWaits.cs" />
  </ItemGroup>

  <!-- The Windows app's XAML and the Mac App's, which the view coverage test reads to hold the two to the same view models. Content, as
       Avalonia's build takes any None *.axaml out. -->
  <ItemGroup>
    <Content Include="..\Skua.WPF\**\*.xaml" Exclude="..\Skua.WPF\bin\**;..\Skua.WPF\obj\**" Link="ViewSources\Wpf\Skua.WPF\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\Skua.App.WPF\**\*.xaml" Exclude="..\Skua.App.WPF\bin\**;..\Skua.App.WPF\obj\**" Link="ViewSources\Wpf\Skua.App.WPF\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\Skua.Manager\**\*.xaml" Exclude="..\Skua.Manager\bin\**;..\Skua.Manager\obj\**" Link="ViewSources\Wpf\Skua.Manager\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\Skua.Avalonia\**\*.axaml" Exclude="..\Skua.Avalonia\bin\**;..\Skua.Avalonia\obj\**" Link="ViewSources\Avalonia\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The Mac App's change log, as the fork serves it to Change Logs, so a test checks the page it makes. -->
  <ItemGroup>
    <Content Include="..\changelogs-mac.md" Link="changelogs-mac.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- AppUpdatesTests runs the release scripts and the build's Info.plist target from the checkout. -->
  <ItemGroup>
    <AssemblyMetadata Include="SkuaRepo" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Avalonia\Skua.Avalonia.csproj" />
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <ProjectReference Include="..\Skua.Engine\Skua.Engine.csproj" />
    <!-- The executables the tests run land next to them: skua, skua-engine (for the take-over tests), fake-gamehost and fake-app. -->
    <ProjectReference Include="..\Skua.App.Cli\Skua.App.Cli.csproj" />
    <ProjectReference Include="..\Skua.App.Engine\Skua.App.Engine.csproj" />
    <ProjectReference Include="..\Skua.FakeGameHost\Skua.FakeGameHost.csproj" />
    <!-- The Skua Manager's tests launch it in place of the Mac App, and Butlerv4Tests as a leader's and a butler's apps. -->
    <ProjectReference Include="..\Skua.FakeApp\Skua.FakeApp.csproj" />
  </ItemGroup>

</Project>
