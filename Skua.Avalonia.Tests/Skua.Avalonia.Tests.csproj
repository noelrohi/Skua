<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia.Headless tests of the Mac App's Avalonia layer, over an Engine hosted in this process as the app hosts it, with the fake Game Host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The Engine tests' fake servers API and fake security tool. -->
  <ItemGroup>
    <Compile Include="..\Skua.Engine.Tests\FakeAqApi.cs" Link="Fakes\FakeAqApi.cs" />
    <Compile Include="..\Skua.Engine.Tests\FakeKeychain.cs" Link="Fakes\FakeKeychain.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Avalonia\Skua.Avalonia.csproj" />
    <ProjectReference Include="..\Skua.Control\Skua.Control.csproj" />
    <ProjectReference Include="..\Skua.Engine\Skua.Engine.csproj" />
    <!-- The executables the tests run land next to them: skua and fake-gamehost. -->
    <ProjectReference Include="..\Skua.App.Cli\Skua.App.Cli.csproj" />
    <ProjectReference Include="..\Skua.FakeGameHost\Skua.FakeGameHost.csproj" />
  </ItemGroup>

</Project>
