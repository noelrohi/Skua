+pub(crate) fn track_texture_created(texture: &wgpu::Texture) {
+    use std::sync::atomic::Ordering;
+    TEXTURE_BYTES.fetch_add(texture_bytes(texture), Ordering::Relaxed);
+    TEXTURE_COUNT.fetch_add(1, Ordering::Relaxed);
