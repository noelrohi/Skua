+pub(crate) fn track_texture_dropped(texture: &wgpu::Texture) {
+    use std::sync::atomic::Ordering;
+    TEXTURE_BYTES.fetch_sub(texture_bytes(texture), Ordering::Relaxed);
+    TEXTURE_COUNT.fetch_sub(1, Ordering::Relaxed);
+}
