     alias_to_class_map: FnvHashMap<AvmString<'gc>, ClassObject<'gc>>,
     class_to_alias_map: FnvHashMap<Class<'gc>, AvmString<'gc>>,
 
@@ -228,6 +231,7 @@ impl<'gc> Avm2<'gc> {
             native_custom_constructor_table: Default::default(),
