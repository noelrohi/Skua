-#[derive(Clone, Collect, HasPrefixField)]
-#[collect(no_drop)]
+#[derive(Clone, HasPrefixField)]
 #[repr(C, align(8))]
 pub struct DictionaryObjectData<'gc> {
     /// Base script object
     base: ScriptObjectData<'gc>,
+
+    /// skua #13: `new Dictionary(true)`. Object keys are traced weakly and entries whose key
+    /// died are removed at the end of marking (`Avm2::skua_purge_weak_dictionaries`).
+    weak_keys: std::cell::Cell<bool>,
+}
+
+unsafe impl<'gc> Collect<'gc> for DictionaryObjectData<'gc> {
+    fn trace<C: gc_arena::collect::Trace<'gc>>(&self, cc: &mut C) {
+        if self.weak_keys.get() {
+            self.base.skua_trace_weak_keys(cc);
+        } else {
+            cc.trace(&self.base);
+        }
+    }
+}
+
+impl<'gc> DictionaryObjectWeak<'gc> {
+    pub fn skua_is_dead(self, fc: &gc_arena::Finalization<'gc>) -> bool {
+        self.0.is_dropped() || self.0.is_dead(fc)
+    }
 }
 
 impl<'gc> DictionaryObject<'gc> {
+    /// skua #13: switch to weak keys (`new Dictionary(true)`). Weakening edges needs no barrier.
+    pub fn skua_set_weak_keys(self) {
+        self.0.weak_keys.set(true);
+    }
+
+    /// skua #13: remove entries whose object key the finished marking phase did not reach.
+    pub fn skua_purge_dead_keys(self, fc: &gc_arena::Finalization<'gc>) -> usize {
+        let dead: Vec<DynamicKey<'gc>> = self
+            .base()
+            .values()
+            .iter()
+            .filter_map(|(k, _)| match k {
+                DynamicKey::Object(o) if Gc::downgrade(o.gc_base()).is_dead(fc) => Some(*k),
+                _ => None,
+            })
+            .collect();
+        if !dead.is_empty() {
+            let base = self.base();
+            let mut values = base.values_mut(fc);
+            for k in &dead {
+                values.remove(k);
+            }
+        }
+        dead.len()
+    }
+
     /// Retrieve a value in the dictionary's object space.
     pub fn get_property_by_object(self, name: Object<'gc>) -> Value<'gc> {
         self.base()
diff --git a/core/src/avm2/object/script_object.rs b/core/src/avm2/object/script_object.rs
index 9855272a5..80d9a9be4 100644
--- a/core/src/avm2/object/script_object.rs
+++ b/core/src/avm2/object/script_object.rs
@@ -176,6 +176,26 @@ impl<'gc> ScriptObjectData<'gc> {
 #[derive(Clone, Copy)]
 pub struct ScriptObjectWrapper<'gc>(pub Gc<'gc, ScriptObjectData<'gc>>);
 
+impl<'gc> ScriptObjectData<'gc> {
+    /// skua #13: trace like `derive(Collect)` does, but hold the object keys of `values` weakly
+    /// (`Dictionary(weakKeys = true)`). Dead keys are removed at finalization, see
+    /// `DictionaryObject::skua_purge_dead_keys`.
+    pub fn skua_trace_weak_keys<C: gc_arena::collect::Trace<'gc>>(&self, cc: &mut C) {
+        for (k, v) in self.values.borrow().iter() {
+            match k {
+                DynamicKey::Object(o) => cc.trace(&Gc::downgrade(o.gc_base())),
+                other => cc.trace(other),
+            }
+            cc.trace(v);
+        }
+        cc.trace(&self.slots);
+        cc.trace(&self.bound_methods);
+        cc.trace(&self.proto);
+        cc.trace(&self.instance_class);
+        cc.trace(&self.vtable);
+    }
+}
+
 impl<'gc> ScriptObjectWrapper<'gc> {
     /// Retrieve the values stored directly on this ScriptObjectData.
     pub fn values(&self) -> Ref<'_, DynamicMap<DynamicKey<'gc>, Value<'gc>>> {
