+/// skua #13: `SKUA_POOL_TRIM=<max_age_frames>,<keep_per_size>` bounds the main-frame texture pool
+/// (upstream only clears it on resize).
+fn skua_pool_trim() -> Option<(u64, usize)> {
+    static V: std::sync::OnceLock<Option<(u64, usize)>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let v = std::env::var("SKUA_POOL_TRIM").ok()?;
+        let (a, k) = v.split_once(',')?;
+        Some((a.parse().ok()?, k.parse().ok()?))
+    })
+}
