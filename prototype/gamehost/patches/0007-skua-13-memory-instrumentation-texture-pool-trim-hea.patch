 }
 
 impl TexturePool {
@@ -37,6 +40,31 @@ impl TexturePool {
         Default::default()
     }
 
+    /// skua #13: drop pooled textures whose size has not been asked for in the last `max_age` frames.
+    /// Entries still borrowed are dropped when returned (their pool is gone).
+    /// Also keeps at most `keep` idle textures per size, so one heavy frame doesn't pin its peak forever.
+    pub fn end_frame(&mut self, max_age: u64, keep: usize) {
+        self.frame += 1;
+        let frame = self.frame;
+        let last_used = &self.last_used;
+        self.pools.retain(|k, _| last_used.get(k).is_some_and(|f| frame - f <= max_age));
+        self.last_used.retain(|_, f| frame - *f <= max_age);
+        for pool in self.pools.values() {
+            pool.available.lock().unwrap().truncate(keep);
+        }
+    }
+
+    /// skua #13 instrumentation: (sizes, idle textures, idle bytes).
+    pub fn skua_stats(&self) -> (usize, usize, u64) {
+        let (mut n, mut bytes) = (0, 0u64);
+        for (k, pool) in &self.pools {
+            let c = pool.available.lock().unwrap().len();
+            n += c;
+            bytes += c as u64 * k.size.width as u64 * k.size.height as u64 * 4 * k.sample_count as u64;
+        }
+        (self.pools.len(), n, bytes)
+    }
