+    /// skua #13: what `submit_frame` does to bound per-frame state, for a host that is not rendering:
+    /// submit pending offscreen work and drop the offscreen texture pool.
+    pub fn skua_trim(&mut self) {
+        self.active_frame.submit_direct(&self.descriptors);
+        self.offscreen_texture_pool = TexturePool::new();
+    }
+
     pub fn descriptors(&self) -> &Arc<Descriptors> {
         &self.descriptors
     }
@@ -681,6 +707,9 @@ impl<T: RenderTarget + 'static> RenderBackend for WgpuRenderBackend<T> {
         self.active_frame
             .submit_for_target(&self.descriptors, &self.target, frame_output);
         self.offscreen_texture_pool = TexturePool::new();
+        if let Some((age, keep)) = skua_pool_trim() {
+            self.texture_pool.end_frame(age, keep);
+        }
         self.profiler
             .end_frame()
             .expect("Frame should end successfully");
@@ -1332,3 +1361,14 @@ impl ActiveFrame {
         }
     }
 }
+
+/// skua #13: `SKUA_POOL_TRIM=<max_age_frames>,<keep_per_size>` bounds the main-frame texture pool
+/// (upstream only clears it on resize).
+fn skua_pool_trim() -> Option<(u64, usize)> {
+    static V: std::sync::OnceLock<Option<(u64, usize)>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let v = std::env::var("SKUA_POOL_TRIM").ok()?;
+        let (a, k) = v.split_once(',')?;
+        Some((a.parse().ok()?, k.parse().ok()?))
+    })
+}
