diff --git a/core/src/avm2/object.rs b/core/src/avm2/object.rs
index c35c655b1..9d91e4245 100644
--- a/core/src/avm2/object.rs
+++ b/core/src/avm2/object.rs
@@ -80,6 +80,8 @@ mod xml_list_object;
 mod xml_object;
 
 pub use crate::avm2::object::array_object::{ArrayObject, ArrayObjectWeak, array_allocator};
+pub use crate::avm2::object::script_object::{ScriptObjectData as SkuaScriptObjectData, skua_class_name};
+pub use crate::avm2::object::stage_object::{StageObjectData as SkuaStageObjectData, skua_stage_class_name};
 pub use crate::avm2::object::bitmapdata_object::{
     BitmapDataObject, BitmapDataObjectWeak, bitmap_data_allocator,
 };
diff --git a/core/src/avm2/object/script_object.rs b/core/src/avm2/object/script_object.rs
index 7fbbf13f0..9855272a5 100644
--- a/core/src/avm2/object/script_object.rs
+++ b/core/src/avm2/object/script_object.rs
@@ -490,3 +490,8 @@ pub fn get_dynamic_property<'gc>(
 
     Ok(None)
 }
+
+/// skua #13 census: the AS3 class name of a raw `ScriptObjectData`.
+pub fn skua_class_name(data: &ScriptObjectData<'_>) -> String {
+    data.instance_class.name().local_name().to_string()
+}
diff --git a/core/src/avm2/object/stage_object.rs b/core/src/avm2/object/stage_object.rs
index b6d1936f6..94de97db5 100644
--- a/core/src/avm2/object/stage_object.rs
+++ b/core/src/avm2/object/stage_object.rs
@@ -108,3 +108,8 @@ impl Debug for StageObject<'_> {
             .finish()
     }
 }
+
+/// skua #13 census: the AS3 class name of a raw `StageObjectData`.
+pub fn skua_stage_class_name(data: &StageObjectData<'_>) -> String {
+    super::script_object::skua_class_name(&data.base)
